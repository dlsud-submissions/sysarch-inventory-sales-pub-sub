@model SalesOrderModel

@{
    ViewData["Title"] = "Place Order";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-shopping-cart"></i>
                        Place a New Order
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="PlaceOrder" asp-controller="SalesOrder" method="post">
                        @if (ViewData.ModelState.Values.Any(v => v.Errors.Any()))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <strong>Error!</strong> Please correct the errors below.
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Order ID -->
                        <div class="mb-3">
                            <label asp-for="OrderId" class="form-label fw-bold">Order ID</label>
                            <input asp-for="OrderId" class="form-control" placeholder="e.g., ORD-2026-001" />
                            <span asp-validation-for="OrderId" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Product Name -->
                        <div class="mb-3">
                            <label asp-for="ProductName" class="form-label fw-bold">Product Name</label>
                            <input asp-for="ProductName" class="form-control" placeholder="e.g., Wireless Headphones" />
                            <span asp-validation-for="ProductName" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Quantity -->
                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label fw-bold">Quantity</label>
                            <input asp-for="Quantity" type="number" class="form-control" placeholder="0" min="1" />
                            <span asp-validation-for="Quantity" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Order Type (Dropdown) -->
                        <div class="mb-3">
                            <label asp-for="OrderType" class="form-label fw-bold">Order Type</label>
                            <select asp-for="OrderType" class="form-select">
                                <option value="">-- Select Order Type --</option>
                                <option value="Prepaid">Prepaid</option>
                                <option value="COD">COD (Cash on Delivery)</option>
                            </select>
                            <span asp-validation-for="OrderType" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Status (Dropdown) -->
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-bold">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="">-- Select Status --</option>
                                <option value="Pending">Pending</option>
                                <option value="Fulfilled">Fulfilled</option>
                                <option value="LowStock">Low Stock</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Amount -->
                        <div class="mb-4">
                            <label asp-for="Amount" class="form-label fw-bold">Amount ($)</label>
                            <input asp-for="Amount" type="number" class="form-control" placeholder="0.00" step="0.01" min="0" />
                            <span asp-validation-for="Amount" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                                <i class="fas fa-paper-plane"></i>
                                Submit Order
                            </button>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
