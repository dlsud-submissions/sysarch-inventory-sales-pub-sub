@model SalesOrderModel

@{
    ViewData["Title"] = "Order Confirmation";
    var submittedAt = DateTime.Now;

    var orderTypeBadgeClass = Model.OrderType switch
    {
        "Prepaid" => "badge bg-info",
        "COD" => "badge bg-warning text-dark",
        _ => "badge bg-secondary"
    };

    var statusBadgeClass = Model.Status switch
    {
        "Pending" => "badge bg-secondary",
        "Fulfilled" => "badge bg-success",
        "LowStock" => "badge bg-danger",
        _ => "badge bg-secondary"
    };
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <section class="confirmation-card text-center">
                <div class="confirmation-checkmark mx-auto mb-3" aria-hidden="true">
                    <svg class="confirmation-checkmark-svg" viewBox="0 0 52 52">
                        <circle class="confirmation-checkmark-circle" cx="26" cy="26" r="24" fill="none" />
                        <path class="confirmation-checkmark-check" fill="none" d="M14 27l8 8 17-18" />
                    </svg>
                </div>

                <h1 class="h3 mb-2">Order Submitted Successfully!</h1>
                <p class="text-muted mb-1">Your order has been published to the Service Bus and will be processed shortly.</p>
                <p class="confirmation-timestamp mb-4">
                    Submitted at: @submittedAt.ToString("MMMM d, yyyy h:mm tt")
                </p>

                <div class="table-responsive text-start">
                    <table class="table table-bordered order-summary-table align-middle mb-0">
                        <tbody>
                            <tr>
                                <th scope="row">Order ID</th>
                                <td>@Model.OrderId</td>
                            </tr>
                            <tr>
                                <th scope="row">Product Name</th>
                                <td>@Model.ProductName</td>
                            </tr>
                            <tr>
                                <th scope="row">Quantity</th>
                                <td>@Model.Quantity</td>
                            </tr>
                            <tr>
                                <th scope="row">Amount</th>
                                <td>@Model.Amount.ToString("C")</td>
                            </tr>
                            <tr>
                                <th scope="row">Order Type</th>
                                <td>
                                    <span class="@orderTypeBadgeClass">@Model.OrderType</span>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">Status</th>
                                <td>
                                    <span class="@statusBadgeClass">@Model.Status</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4 justify-content-center">
                    <a href="@Url.Action("PlaceOrder", "SalesOrder")" class="btn btn-primary btn-lg">
                        <i class="fas fa-plus"></i>
                        Place Another Order
                    </a>
                    <a href="@Url.Action("PlaceOrder", "SalesOrder")" class="btn btn-outline-secondary btn-lg">
                        Back to Home
                    </a>
                </div>
            </section>
        </div>
    </div>
</div>
